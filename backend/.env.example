PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Production CORS must be exact origins (comma-separated). For dev, * is allowed.
CORS_ORIGIN=*

UPLOAD_DIR=./uploads

# MongoDB Configuration
# Note: Transactions require a replica set (e.g. MongoDB Atlas or a local mongod --replSet rs0)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/hospital_signage?retryWrites=true&w=majority
MONGODB_DB_NAME=hospital_signage
MONGODB_MAX_POOL=10

# Admin User Initialization (only used if DB is empty)
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=CHANGE_ME
ADMIN_PIN=CHANGE_ME
